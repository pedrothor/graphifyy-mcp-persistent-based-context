# Copie para .env e ajuste. Todas as variáveis são opcionais — os defaults
# funcionam pra rodar o MCP em modo local sem nenhuma dependência externa.

# --- Backend de storage --------------------------------------------------
# "local"  -> montydb + SQLite em LOCAL_DATA_DIR. Não precisa de MongoDB.
# "remote" -> MongoDB via MONGODB_URI (requer servidor Mongo acessível).
STORAGE_MODE=local

# Diretório dos dados no modo local. Aceita path relativo ou absoluto.
LOCAL_DATA_DIR=./data

# --- MongoDB (usado apenas se STORAGE_MODE=remote) -----------------------
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB=elos_agent
MONGODB_COLLECTION=mcp

# --- MCP -----------------------------------------------------------------
# Habilita as tools index_repo / remove_repo no servidor MCP.
# Deixe false em produção; use MongoStore.publish_repo() via job externo.
MCP_ALLOW_WRITES=false

# Projeto default. Se setado, TRAVA o server nesse projeto: qualquer write
# (index_repo, add_fact) é forçado nesse valor, ignorando o que o agente
# passar. Reads também filtram por ele. Deixe vazio no dev pra permitir
# multi-tenant (agente controla per-call).
DEFAULT_PROJECT=

# Transport do servidor MCP.
# "stdio" -> spawn local por cliente (VS Code, Claude Desktop, etc). Default.
# "http"  -> serve streamable HTTP via uvicorn (para deploy em cluster).
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000
